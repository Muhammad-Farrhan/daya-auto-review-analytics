          <filter class='quantitative' column='[federated.1suynq51iasmjy1akr6nl03c6nyl].[none:review_month:qk]' included-values='in-range-or-null'>
            <min>#2024-01-01#</min>
            <max>#2026-11-01#</max>
          </filter>
          <filter class='categorical' column='[federated.1suynq51iasmjy1akr6nl03c6nyl].[none:topic_label:nk]'>
            <groupfilter count='5' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([n_negative_mentions])' function='order' user:ui-marker='order'>
                <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
