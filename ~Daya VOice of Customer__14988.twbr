      <aliases enabled='yes' />
      <column caption='Weighted Rating' datatype='real' name='[Calculation_0269718123732992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_rating] * [n_reviews]) / SUM([n_reviews])' />
      </column>
      <column caption='Weighted % Negative' datatype='real' name='[Calculation_0269718131380229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pct_negative] * [n_reviews]) / SUM([n_reviews])' />
      </column>
      <column caption='Today Date' datatype='date' name='[Calculation_0269718131593222]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='Pie Size' datatype='integer' name='[Calculation_0900563131899904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Positive Count' datatype='real' name='[Calculation_0900563139690497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_reviews] * [pct_positive]) / 100' />
      </column>
      <column caption='Negative Count' datatype='real' name='[Calculation_0900563139756034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_reviews] * [pct_negative]) / 100' />
      </column>
      <column caption='Weighted Negative' datatype='real' name='[Calculation_0900563169173510]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pct_negative] * [n_reviews]) / SUM([n_reviews])' />
      </column>
      <column caption='Weight Positive' datatype='real' name='[Calculation_2311236727140352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - [Calculation_0900563169173510]' />
      </column>
      <column caption='Formatted Reply Time' datatype='string' name='[Calculation_2311236758360065]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([median_reply_hours]), 0)) + &quot; Jam&quot;' />
      </column>
